# =============================================================================
# STARTUP GRAVEYARD AI — Environment Configuration Example
# =============================================================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or any .env file to git.
# =============================================================================

# --- Supabase ---
# Get these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key (server-side only, NEVER expose to client):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- AI Provider (NVIDIA NIM) ---
# Get from https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# --- AI Model Configuration ---
# Default model for chat and generation
AI_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Optional) ---
# Connection timeout in milliseconds (default: 8000)
SUPABASE_DB_TIMEOUT=8000

# --- Rate Limiting (Optional) ---
# Rate limit window in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window (default: 30)
RATE_LIMIT_MAX_REQUESTS=30
