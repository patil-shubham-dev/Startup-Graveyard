#!/bin/sh
# Startup Graveyard AI — Pre-commit Hook
# Prevents committing secrets, API keys, or .env files

echo "🔍 Running pre-commit security scan..."

# Block .env files from being committed
AGAINST=$(git hash-object -t tree /dev/null 2>/dev/null || printf "0")
ENV_FILES=$(git diff --cached --name-only | grep -E '\.env$|\.env\.local$|\.env\.development$|\.env\.production$' || true)

if [ -n "$ENV_FILES" ]; then
  echo "❌ ERROR: Attempting to commit .env files!"
  echo "$ENV_FILES"
  echo "Remove them from staging: git rm --cached <file>"
  exit 1
fi

# Check for potential API keys in staged changes
STAGED_FILES=$(git diff --cached --name-only)
for FILE in $STAGED_FILES; do
  if [ -f "$FILE" ]; then
    # Check for common API key patterns
    SUSPICIOUS=$(git show :"$FILE" | grep -E '(sk-[a-zA-Z0-9]{20,}|nvidia-[a-zA-Z0-9]{20,}|nvapi-[a-zA-Z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9]{82}|xox[bp]-[a-zA-Z0-9]{10,}|eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,})' || true)
    if [ -n "$SUSPICIOUS" ]; then
      echo "⚠️  WARNING: Potential API key/sensitive pattern found in $FILE"
      echo "  $SUSPICIOUS"
      echo "  If this is intentional, use: git commit --no-verify"
      exit 1
    fi
  fi
done

echo "✅ Security scan passed"
exit 0
